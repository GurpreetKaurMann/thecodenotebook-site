rules_version = '2';
// Paste into Firebase console → Firestore Database → Rules → Publish
service cloud.firestore {
  match /databases/{database}/documents {

    // You are an admin if a document with your user ID exists in the "admins" collection.
    // Create it by hand in the Firebase console: Firestore -> Start collection "admins"
    // -> Document ID = your UID (copy it from Authentication -> Users) -> add any field.
    // Nothing in the browser can create or change these documents.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      // You may check whether YOU are an admin; nobody can write this from the website.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      // The signed-in owner reads their own profile. An admin may read them all.
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();

      // Owner creates their profile once, with only these fields.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt', 'progress', 'waitlist'])
        && request.resource.data.email == request.auth.token.email;

      // Owner may change only name, progress and waitlist.
      // Fields like 'purchases' can only be written by your server (Admin SDK), never by the browser.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'progress', 'waitlist', 'updatedAt']);

      allow delete: if false;
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
