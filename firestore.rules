rules_version = '2';
// Paste into Firebase console → Firestore Database → Rules → Publish
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      // Only the signed-in owner can read their own profile.
      allow read: if request.auth != null && request.auth.uid == uid;

      // Owner creates their profile once, with only these fields.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt', 'progress', 'waitlist'])
        && request.resource.data.email == request.auth.token.email;

      // Owner may change only name, progress and waitlist.
      // Fields like 'purchases' can only be written by your server (Admin SDK), never by the browser.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'progress', 'waitlist', 'updatedAt']);

      allow delete: if false;
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
